{
  "name": "nexo-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "worker": "node --conditions=react-server --import tsx src/workers/index.ts",
    "db:seed": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f prisma/seed.sql",
    "test:db": "psql \"$TEST_PLATFORM_DATABASE_URL\" -v ON_ERROR_STOP=1 -f tests/sql/integration.sql && vitest run tests/integration",
    "demo:seed": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f prisma/demo-seed.sql",
    "demo:sales": "node --env-file=.env.local --conditions=react-server --import tsx scripts/demo-sales.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "next": "^16.4.1",
    "node-forge": "^1.4.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "xml-crypto": "^6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
