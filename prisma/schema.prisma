// ══════════════════════════ PLANO DE PLATAFORMA ══════════════════════════

model PlatformAdmin {
  id             String       @id @db.Uuid // = auth.users.id
  email          String       @unique
  full_name      String
  role           PlatformRole @default(SUPPORT)
  mfa_required   Boolean      @default(true)
  last_reauth_at DateTime?    @db.Timestamptz(6)
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at     DateTime?    @db.Timestamptz(6)

  impersonations ImpersonationSession[]

  @@map("platform_admins")
}

model Plan {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String      @unique
  name                String
  monthly_price_pen   Decimal     @db.Decimal(10, 2)
  annual_price_pen    Decimal?    @db.Decimal(10, 2)
  max_users           Int
  max_branches        Int
  max_documents_month Int
  max_ai_pages_month  Int
  included_modules    ModuleKey[]
  trial_days          Int         @default(14)
  is_public           Boolean     @default(true)
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  updated_at          DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?   @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String             @db.Uuid
  plan_id              String             @db.Uuid
  status               SubscriptionStatus @default(TRIALING)
  payment_status       PaymentStatus      @default(PENDING)
  trial_ends_at        DateTime?          @db.Timestamptz(6)
  current_period_start DateTime           @db.Timestamptz(6)
  current_period_end   DateTime           @db.Timestamptz(6)
  auto_renew           Boolean            @default(true)
  last_payment_at      DateTime?          @db.Timestamptz(6)
  canceled_at          DateTime?          @db.Timestamptz(6)
  /// Overrides de límites negociados (null = usa el plan)
  limit_overrides      Json?
  created_at           DateTime           @default(now()) @db.Timestamptz(6)
  updated_at           DateTime           @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  plan   Plan   @relation(fields: [plan_id], references: [id])

  @@index([tenant_id, status])
  @@index([current_period_end])
  @@map("subscriptions")
}

model UsageCounter {
  tenant_id  String   @db.Uuid
  period     String // YYYY-MM (America/Lima)
  metric     String // documents | ai_pages | ai_input_tokens | ai_output_tokens | whatsapp_messages
  value      BigInt   @default(0)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@id([tenant_id, period, metric])
  @@map("usage_counters")
}

model TenantModule {
  tenant_id  String    @db.Uuid
  module     ModuleKey
  enabled    Boolean   @default(true)
  config     Json      @default("{}")
  enabled_at DateTime  @default(now()) @db.Timestamptz(6)
  enabled_by String?   @db.Uuid
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@id([tenant_id, module])
  @@map("tenant_modules")
}

/// Append-only. UPDATE/DELETE bloqueados por trigger; cadena de hash por tenant.
model AuditLog {
  id               BigInt   @id @default(autoincrement())
  occurred_at      DateTime @default(now()) @db.Timestamptz(6)
  tenant_id        String?  @db.Uuid
  actor_user_id    String?  @db.Uuid
  actor_kind       String // tenant_user | platform_admin | system | impersonator
  impersonation_id String?  @db.Uuid
  action           String // ej. tenant.suspend, document.void, product.update
  entity_type      String
  entity_id        String?
  before           Json?
  after            Json?
  reason           String?
  ip               String?
  user_agent       String?
  request_id       String?
  prev_hash        String?
  hash             String   @default("") // lo calcula el trigger app.audit_chain

  @@index([tenant_id, occurred_at(sort: Desc)])
  @@index([entity_type, entity_id])
  @@index([actor_user_id, occurred_at(sort: Desc)])
  @@map("audit_logs")
}

model ImpersonationSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform_admin_id String    @db.Uuid
  tenant_id         String    @db.Uuid
  target_user_id    String?   @db.Uuid
  reason            String
  ticket_ref        String?
  read_only         Boolean   @default(true)
  started_at        DateTime  @default(now()) @db.Timestamptz(6)
  expires_at        DateTime  @db.Timestamptz(6)
  ended_at          DateTime? @db.Timestamptz(6)
  ip                String?
  user_agent        String?

  platform_admin PlatformAdmin @relation(fields: [platform_admin_id], references: [id])
  tenant         Tenant        @relation(fields: [tenant_id], references: [id])

  @@index([platform_admin_id, started_at(sort: Desc)])
  @@index([tenant_id, started_at(sort: Desc)])
  @@map("impersonation_sessions")
}

model TenantExport {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  requested_by String    @db.Uuid
  status       String    @default("PENDING") // PENDING | RUNNING | READY | FAILED
  storage_path String?
  sha256       String?
  expires_at   DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  completed_at DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, created_at(sort: Desc)])
  @@map("tenant_exports")
}

// ══════════════════════════════ NÚCLEO ══════════════════════════════

model Tenant {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String           @unique
  ruc                    String           @unique @db.Char(11)
  legal_name             String
  trade_name             String?
  business_lines         BusinessLine[]
  fiscal_address         String
  ubigeo                 String           @db.Char(6)
  department             String
  province               String
  district               String
  urbanization           String?
  contact_name           String?
  contact_email          String
  contact_phone          String?
  logo_path              String?
  timezone               String           @default("America/Lima")
  status                 TenantStatus     @default(TRIAL)
  sunat_env              SunatEnvironment @default(BETA)
  ose_provider           OseProvider      @default(SUNAT_SEE)
  ose_endpoint           String?
  sol_user               String? // usuario secundario SOL (no es secreto; la clave sí)
  certificate_expires_at DateTime?        @db.Timestamptz(6)
  sunat_beta_passed_at   DateTime?        @db.Timestamptz(6)
  onboarding_step        Int              @default(0)
  suspended_at           DateTime?        @db.Timestamptz(6)
  suspension_reason      String?
  deletion_requested_at  DateTime?        @db.Timestamptz(6)
  purge_after            DateTime?        @db.Timestamptz(6)
  created_at             DateTime         @default(now()) @db.Timestamptz(6)
  updated_at             DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at             DateTime?        @db.Timestamptz(6)

  modules        TenantModule[]
  subscriptions  Subscription[]
  usage          UsageCounter[]
  impersonations ImpersonationSession[]
  exports        TenantExport[]
  secrets        TenantSecret[]
  branches       Branch[]
  members        TenantUser[]
  roles          Role[]

  @@index([status])
  @@map("tenants")
}

/// Secretos cifrados con envelope encryption (AES-256-GCM, DEK envuelta con KEK/KMS).
/// Sin acceso para roles de tenant: solo service_role / workers.
model TenantSecret {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String     @db.Uuid
  kind            SecretKind
  version         Int        @default(1)
  ciphertext      Bytes
  iv              Bytes
  auth_tag        Bytes
  wrapped_dek     Bytes
  kek_id          String
  /// Metadatos no sensibles del certificado
  cert_subject    String?
  cert_serial     String?
  cert_not_before DateTime?  @db.Timestamptz(6)
  cert_not_after  DateTime?  @db.Timestamptz(6)
  fingerprint     String?
  is_active       Boolean    @default(true)
  created_by      String?    @db.Uuid
  created_at      DateTime   @default(now()) @db.Timestamptz(6)
  rotated_at      DateTime?  @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, kind, is_active])
  @@map("tenant_secrets")
}

/// Establecimiento anexo SUNAT (código 0000 = domicilio fiscal)
model Branch {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String    @db.Uuid
  sunat_code String    @db.Char(4)
  name       String
  address    String
  ubigeo     String    @db.Char(6)
  phone      String?
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenant_id], references: [id])
  series    DocumentSeries[]
  batches   ProductBatch[]
  documents Document[]

  @@unique([tenant_id, sunat_code])
  @@unique([tenant_id, id])
  @@map("branches")
}

/// Perfil de usuario (id = auth.users.id)
model User {
  id         String    @id @db.Uuid
  email      String    @unique
  full_name  String
  phone      String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  memberships TenantUser[]

  @@map("users")
}

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  key         String // admin | cashier | warehouse | veterinarian | pharmacist | accountant | custom:*
  name        String
  permissions String[]
  is_system   Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  tenant  Tenant       @relation(fields: [tenant_id], references: [id])
  members TenantUser[]

  @@unique([tenant_id, key])
  @@map("roles")
}

model TenantUser {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  user_id     String    @db.Uuid
  role_id     String    @db.Uuid
  branch_ids  String[]  @db.Uuid // vacío = todas
  status      String    @default("INVITED") // INVITED | ACTIVE | DISABLED
  invited_by  String?   @db.Uuid
  invited_at  DateTime? @db.Timestamptz(6)
  accepted_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenant_id], references: [id])
  user   User   @relation(fields: [user_id], references: [id])
  role   Role   @relation(fields: [role_id], references: [id])

  @@unique([tenant_id, user_id])
  @@index([user_id])
  @@map("tenant_users")
}

model Customer {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String          @db.Uuid
  doc_type        IdentityDocType
  doc_number      String
  name            String
  address         String?
  ubigeo          String?         @db.Char(6)
  email           String?
  phone           String?
  whatsapp_opt_in Boolean         @default(false)
  notes           String?
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?       @db.Timestamptz(6)

  @@index([tenant_id, name])
  @@map("customers") // único (tenant, doc_type, doc_number) parcial en SQL
}

model Supplier {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String    @db.Uuid
  ruc        String    @db.Char(11)
  legal_name String
  trade_name String?
  address    String?
  email      String?
  phone      String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  purchases Purchase[]

  @@map("suppliers") // único (tenant, ruc) parcial en SQL
}

// ═══════════════════════════ INVENTARIO COMÚN ═══════════════════════════

model ProductCategory {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String    @db.Uuid
  name       String
  parent_id  String?   @db.Uuid
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  products Product[]

  @@unique([tenant_id, name])
  @@map("product_categories")
}

model Product {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String   @db.Uuid
  category_id       String?  @db.Uuid
  sku               String
  barcode           String?
  name              String
  description       String?
  /// Catálogo 03 (UN/ECE rec 20): NIU, KGM, LTR, BX, ZZ...
  unit_code         String   @default("NIU")
  /// Catálogo 07 afectación IGV (10 gravado, 20 exonerado, 30 inafecto, ...)
  igv_affectation   String   @default("10") @db.Char(2)
  /// Precio de venta por unidad base, IGV incluido
  sale_price        Decimal  @db.Decimal(14, 4)
  /// Precio por empaque (caja/blíster), IGV incluido; null = no se vende por empaque
  package_price     Decimal? @db.Decimal(14, 4)
  units_per_package Int      @default(1)
  package_unit_code String? // ej. BX
  allow_fractional  Boolean  @default(false) // venta a granel (kg, L)
  min_stock         Decimal  @default(0) @db.Decimal(14, 3)
  tracks_batches    Boolean  @default(true)
  is_service        Boolean  @default(false)
  icbper            Boolean  @default(false)
  is_active         Boolean  @default(true)

  // ── Agro / Veterinaria ──
  senasa_registration  String?
  withdrawal_days_meat Int?
  withdrawal_days_milk Int?
  target_species       Species[]

  // ── Farmacia (DIGEMID) ──
  digemid_registration String?
  dci                  String? // Denominación Común Internacional
  concentration        String?
  pharmaceutical_form  String?
  laboratory           String?
  pharmaceutical_kind  PharmaceuticalKind?
  sale_condition       SaleCondition?
  is_controlled        Boolean             @default(false)
  controlled_list      String? // ej. Lista IIA, IIIA (DS 023-2001-SA)
  digemid_product_code String? // código Observatorio de Precios

  /// Embedding para emparejamiento IA (pgvector)
  embedding Unsupported("vector(1024)")?

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)

  category       ProductCategory?         @relation(fields: [category_id], references: [id])
  batches        ProductBatch[]
  stockMovements StockMovement[]
  controlledLogs ControlledSubstanceLog[]

  @@unique([tenant_id, id])
  @@index([tenant_id, dci])
  @@map("products") // únicos parciales (sku, barcode) e índices trigram en SQL
}

model ProductBatch {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  branch_id        String    @db.Uuid
  product_id       String    @db.Uuid
  lot_code         String
  expiry_date      DateTime? @db.Date
  unit_cost        Decimal   @db.Decimal(18, 6) // costo por unidad base, sin IGV
  stock            Decimal   @db.Decimal(14, 3) // unidad base; CHECK >= 0
  received_at      DateTime  @default(now()) @db.Timestamptz(6)
  purchase_item_id String?   @db.Uuid
  is_quarantined   Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)

  // FK compuestas por tenant: un lote no puede apuntar a producto/sucursal de otro tenant
  product      Product           @relation(fields: [tenant_id, product_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "product_batches_product_tenant_fk")
  branch       Branch            @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "product_batches_branch_tenant_fk")
  movements    StockMovement[]
  lots         DocumentItemLot[]
  vaccinations PetVaccination[]

  @@unique([tenant_id, branch_id, product_id, lot_code])
  @@index([tenant_id, branch_id, product_id, expiry_date]) // FEFO
  @@index([tenant_id, expiry_date])
  @@map("product_batches")
}

/// Kardex append-only (unidad base). quantity con signo.
model StockMovement {
  id            BigInt            @id @default(autoincrement())
  tenant_id     String            @db.Uuid
  branch_id     String            @db.Uuid
  product_id    String            @db.Uuid
  batch_id      String?           @db.Uuid
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 3)
  balance_after Decimal           @db.Decimal(14, 3)
  unit_cost     Decimal?          @db.Decimal(18, 6)
  ref_type      String? // document | purchase | adjustment | medical_record
  ref_id        String?           @db.Uuid
  note          String?
  created_by    String?           @db.Uuid
  created_at    DateTime          @default(now()) @db.Timestamptz(6)

  product Product       @relation(fields: [tenant_id, product_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "stock_movements_product_tenant_fk")
