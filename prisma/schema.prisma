// ═══════════════════════════════════════════════════════════════════════════
// Nexo ERP — esquema multi-tenant (PostgreSQL / Supabase)
//
// Convenciones:
//   • Columnas snake_case idénticas en Prisma y SQL (las consultas raw y las
//     políticas RLS usan los mismos nombres).
//   • Toda tabla de negocio tiene tenant_id, created_at, updated_at, deleted_at.
//   • Cantidades de inventario SIEMPRE en unidad base (unidad mínima vendible).
//   • Dinero: Decimal(14,2) totales; Decimal(18,10) valores unitarios (UBL).
//   • RLS, triggers, índices parciales, CHECKs y funciones viven en
//     supabase/migrations/*.sql (Prisma no los expresa).
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, vector, pgcrypto, unaccent]
}

