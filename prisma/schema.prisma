  customer_name       String
  customer_address    String?

  op_gravadas    Decimal @default(0) @db.Decimal(14, 2)
  op_exoneradas  Decimal @default(0) @db.Decimal(14, 2)
  op_inafectas   Decimal @default(0) @db.Decimal(14, 2)
  op_gratuitas   Decimal @default(0) @db.Decimal(14, 2)
  total_discount Decimal @default(0) @db.Decimal(14, 2)
  igv            Decimal @default(0) @db.Decimal(14, 2)
  icbper         Decimal @default(0) @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  // NC/ND
  ref_document_id  String? @db.Uuid
  note_reason_code String? @db.Char(2) // catálogo 09 / 10
  note_reason_text String?

  status            DocumentStatus @default(PENDIENTE)
  sunat_code        String?
  sunat_description String?
  sunat_notes       String[]
  hash              String? // DigestValue
  xml_path          String?
  cdr_path          String?
  sent_at           DateTime?      @db.Timestamptz(6)
  accepted_at       DateTime?      @db.Timestamptz(6)
  void_reason       String?
  voided_at         DateTime?      @db.Timestamptz(6)
  /// Idempotencia de POS (UUID generado en el cliente)
  idempotency_key   String?        @db.Uuid
  created_by        String?        @db.Uuid
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at        DateTime?      @db.Timestamptz(6)

  branch      Branch            @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "documents_branch_tenant_fk")
  refDocument Document?         @relation("DocumentReference", fields: [ref_document_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "documents_ref_fk")
  notes       Document[]        @relation("DocumentReference")
  items       DocumentItem[]
  payments    DocumentPayment[]
  submissions SunatSubmission[]

  @@unique([tenant_id, doc_type, series, number])
  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id, status, created_at])
  @@index([tenant_id, issue_date])
  @@map("documents")
}

