# ───────── App ─────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ───────── Base de datos (Supabase Postgres) ─────────
# Runtime de tenant: rol "app_runtime" (NOBYPASSRLS) vía pooler en modo transaction
DATABASE_URL=postgresql://app_runtime.PROJECT_REF:CHANGE_ME@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Plano de plataforma y workers: rol propietario (BYPASSRLS). Solo servidor.
PLATFORM_DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Migraciones: conexión directa con rol propietario
DIRECT_URL=postgresql://postgres:CHANGE_ME@db.PROJECT_REF.supabase.co:5432/postgres

# ───────── Supabase ─────────
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor/worker. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ───────── Cifrado de secretos de tenant (Clave SOL, .pfx) ─────────
# KEK de 32 bytes en base64:  openssl rand -base64 32
# En producción reemplazar por KMS (AWS KMS / GCP KMS) — ver docs/ARCHITECTURE.md §Seguridad
SECRETS_KEK_BASE64=
SECRETS_KEK_ID=local-v1

# ───────── SUNAT / OSE ─────────
# beta | production
SUNAT_ENV=beta
SUNAT_BETA_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_PROD_URL=https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService
# Consulta de RUC (proveedor externo, opcional)
RUC_LOOKUP_URL=
RUC_LOOKUP_TOKEN=

# ───────── IA (Claude) ─────────
ANTHROPIC_API_KEY=
# Opcional: embeddings para emparejamiento semántico (pgvector). Sin esto se usa historial + código + trigramas.
VOYAGE_API_KEY=

# ───────── Notificaciones ─────────
WHATSAPP_PROVIDER=meta            # meta | twilio
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
RESEND_API_KEY=
EMAIL_FROM="Nexo ERP <no-reply@tu-dominio.pe>"

# ───────── Workers / cron ─────────
# Secreto compartido (≥ 32 caracteres) para que pg_cron invoque /api/internal/outbox
#   openssl rand -hex 32
INTERNAL_CRON_SECRET=

# ───────── Tests de integración (BD desechable, NUNCA producción) ─────────
TEST_DATABASE_URL=
TEST_PLATFORM_DATABASE_URL=
